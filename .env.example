POSTGRES_DB=newtonite
POSTGRES_USER=newtonite
POSTGRES_PASSWORD=newtonite_dev
# Used when running FastAPI directly against PostgreSQL installed on this computer.
# Docker Compose sets DATABASE_URL from the POSTGRES_* values above for its API container.
DATABASE_URL=postgresql+psycopg://newtonite:newtonite_dev@localhost:5432/newtonite
JWT_SECRET=local-demo-secret-change-before-deploy
